{
  "name": "nextjs-template",
  "version": "2.1.2",
  "author": "Nishant Kohli",
  "description": "Next.js v16 template with Material-UI, Docker, and Tailwind CSS",
  "private": true,
  "scripts": {
    "set-up": "sh setup.sh",
    "dev": "next dev -p 3000 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "prod": "pnpm build && pnpm start",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky || true",
    "check-updates": "ncu --format group -u",
    "install-updates": "pnpm check-updates && pnpm install"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@nish1896/mui-components": "^2.3.1",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@nish1896/eslint-flat-config": "^3.1.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{json,html,css,sass,scss}": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.20.0",
  "keywords": [
    "react",
    "nextjs",
    "template",
    "material-ui",
    "tailwindcss",
    "docker"
  ],
  "license": "MIT"
}
